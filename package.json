        }
      ]
    },
    "debuggers": [
      {
        "type": "zephyr-ide",
        "label": "Zephyr IDE",
        "languages": [
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "runner": {
                "type": "string",
                "description": "Optional Zephyr runner to use (e.g. \"jlink\", \"openocd\", \"pyocd\", \"stlink\", \"bmp\"). When omitted, the runner is read from runners.yaml."
              },
              "svdFile": {
                "type": "string",
                "description": "Optional path to an SVD file for the cortex-debug peripheral viewer."
              }
            }
          },
          "attach": {
            "properties": {
              "runner": {
                "type": "string",
                "description": "Optional Zephyr runner to use. When omitted, the runner is read from runners.yaml."
              },
              "svdFile": {
                "type": "string",
                "description": "Optional path to an SVD file for the cortex-debug peripheral viewer."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Zephyr IDE: Debug",
            "type": "zephyr-ide",
            "request": "launch"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Zephyr IDE: Debug",
            "description": "Debug the active build using runners.yaml (no runner-specific config required).",
            "body": {
              "name": "Zephyr IDE: Debug",
              "type": "zephyr-ide",
              "request": "launch"
            }
          },
          {
            "label": "Zephyr IDE: Attach",
            "description": "Attach to the active build using runners.yaml.",
            "body": {
              "name": "Zephyr IDE: Attach",
              "type": "zephyr-ide",
              "request": "attach"
            }
          },
          {
            "label": "Zephyr IDE (Cortex Debug): Debug BMP",
            "description": "Basic Cortex Debug example with blackmagic probe",
            "body": {
              "name": "Zephyr IDE: Debug",
              "cwd": "^\"\\${workspaceFolder}\"",
              "gdbPath": "^\"\\${command:zephyr-ide.get-gdb-path}\"",
              "executable": "^\"\\${command:zephyr-ide.get-zephyr-elf}\"",
              "request": "launch",
              "type": "cortex-debug",
              "servertype": "bmp",
              "interface": "swd",
              "device": "STM32F103",
              "BMPGDBSerialPort": "^\"\\${config:bmp_serial_port}\"",
              "preLaunchCommands": [
                "monitor rtt enable"
              ]
            }
          },
          {
            "label": "Zephyr IDE (Cortex Debug): Attach BMP",
            "description": "Basic Cortex Debug attach example with blackmagic probe",
            "body": {
              "name": "Zephyr IDE: Attach",
              "cwd": "^\"\\${workspaceFolder}\"",
              "gdbPath": "^\"\\${command:zephyr-ide.get-gdb-path}\"",
              "executable": "^\"\\${command:zephyr-ide.get-zephyr-elf}\"",
              "request": "launch",
              "type": "cortex-debug",
              "servertype": "bmp",
              "interface": "swd",
              "device": "STM32F103",
              "BMPGDBSerialPort": "^\"\\${config:bmp_serial_port}\"",
              "preLaunchCommands": [
                "monitor rtt enable"
              ]
            }
          },
          {
            "label": "Zephyr IDE (Cortex Debug): Debug Select BMP",
            "description": "An example where a user will select a build each time the configuration is run",
            "body": {
              "name": "Zephyr IDE: Debug Select",
              "cwd": "^\"\\${workspaceFolder}\"",
              "gdbPath": "^\"\\${command:zephyr-ide.get-gdb-path}\"",
              "executable": "^\"\\${command:zephyr-ide.get-zephyr-elf}\"",
              "request": "launch",
              "type": "cortex-debug",
              "servertype": "bmp",
              "interface": "swd",
              "device": "STM32F103",
              "BMPGDBSerialPort": "^\"\\${config:bmp_serial_port}\"",
              "preLaunchCommands": [
                "monitor rtt enable"
              ]
            }
          },
          {
            "label": "Zephyr IDE (Cortex Debug): Debug openOCD",
            "description": "Basic Cortex Debug example with OpenOCD, st-link, and nrf52",
            "body": {
              "name": "Zephyr IDE: Debug",
              "cwd": "^\"\\${workspaceFolder}\"",
              "gdbPath": "^\"\\${command:zephyr-ide.get-gdb-path}\"",
              "executable": "^\"\\${command:zephyr-ide.get-zephyr-elf}\"",
              "request": "launch",
              "type": "cortex-debug",
              "servertype": "openocd",
              "configFiles": [
                "interface/stlink.cfg",
                "target/nrf52.cfg"
              ],
              "rtos": "Zephyr",
              "searchDir": [],
              "runToEntryPoint": "main",
              "showDevDebugOutput": "none",
              "rttConfig": {
                "enabled": true,
                "address": "auto",
                "rtt_start_retry": 1000,
                "decoders": [
                  {
                    "label": "RTT channel 0",
                    "port": 0,
                    "type": "console"
                  }
                ]
              }
            }
          },
          {
            "label": "Zephyr IDE (Cortex Debug): Debug Attach openOCD",
            "description": "Basic Cortex Debug Attach example with OpenOCD, st-link, and nrf52",
            "body": {
              "name": "Zephyr IDE: Debug Attach",
              "cwd": "^\"\\${workspaceFolder}\"",
              "gdbPath": "^\"\\${command:zephyr-ide.get-gdb-path}\"",
              "executable": "^\"\\${command:zephyr-ide.get-zephyr-elf}\"",
              "request": "attach",
              "type": "cortex-debug",
              "servertype": "openocd",
              "configFiles": [
                "interface/stlink.cfg",
                "target/nrf52.cfg"
              ],
              "rtos": "Zephyr",
              "searchDir": [],
              "runToEntryPoint": "main",
              "showDevDebugOutput": "none",
              "rttConfig": {
                "enabled": true,
                "address": "auto",
                "rtt_start_retry": 1000,
                "decoders": [
                  {
                    "label": "RTT channel 0",
                    "port": 0,
                    "type": "console"
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify && npm run esbuild-webview-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild-webview-base": "esbuild ./src/panels/host_tool_install_view/host-tool-install.ts ./src/panels/setup_panel/setup-panel.ts ./src/panels/project_build_view/project-build-panel.ts ./src/panels/settings_view/settings-panel.ts ./src/panels/sdk_panel/sdk-panel.ts ./src/panels/workspace_panel/workspace-panel.ts ./src/panels/dashboard_view/dashboard-panel.ts --bundle --outdir=dist/webview --outbase=src/panels --format=iife --platform=browser --tsconfig=tsconfig.webview.json",
    "esbuild": "npm run esbuild-base -- --sourcemap && npm run esbuild-webview-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "test-compile": "tsc -p ./ && tsc -p ./tsconfig.webview.json",
    "compile": "tsc -p ./ && tsc -p ./tsconfig.webview.json",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run esbuild && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "detect-unused": "node scripts/detect-unused-code.js",
    "version": "npx auto-changelog -p && git add CHANGELOG.md"
  },
