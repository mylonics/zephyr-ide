{
	"version": "2.0.0",
	"tasks": [
		// ── Build ──────────────────────────────────────────────────────────────
		{
			"label": "watch",
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "compile",
			"type": "npm",
			"script": "test-compile",
			"problemMatcher": "$tsc",
			"group": "build",
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			}
		},
		{
			"label": "esbuild",
			"type": "npm",
			"script": "esbuild",
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			}
		},
		{
			"label": "lint",
			"type": "npm",
			"script": "lint",
			"problemMatcher": "$eslint-stylish",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		// ── Unit tests (fast, no VS Code download required) ────────────────────
		{
			"label": "test: all unit tests",
			"type": "npm",
			"script": "test",
			"problemMatcher": [],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"dependsOn": "compile"
		},
		{
			"label": "test: build-command-assembly",
			"type": "shell",
			"command": "npx vscode-test --grep build-command-assembly",
			"problemMatcher": [],
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"dependsOn": "compile"
		},
		{
			"label": "test: build-args-migration",
			"type": "shell",
			"command": "npx vscode-test --grep build-args-migration",
			"problemMatcher": [],
			"group": "test",
			"presentation": {
				"reveal": "always",
